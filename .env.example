# ReLoop Market · biến môi trường mẫu
# Sao chép thành .env ở local nếu ứng dụng được cấu hình để nạp dotenv; hiện start-demo.ps1 đặt biến demo trực tiếp.
# Không commit .env hoặc điền secret thật vào tệp này.
RELOOP_HOST=127.0.0.1
RELOOP_PORT=8000
RELOOP_DB=./reloop.sqlite3
RELOOP_ENV=development
RELOOP_COOKIE_SECURE=0
RELOOP_ADMIN_EMAIL=
RELOOP_ADMIN_PASSWORD=
RELOOP_BACKUP_DIR=./backups
RELOOP_PUBLIC_BASE_URL=
RELOOP_POLICY_VERSION=draft-2026-10-20

# VNPay Sandbox: cần merchant test và URL callback HTTPS public; để trống thì checkout VNPay bị chặn.
RELOOP_VNPAY_TMN_CODE=
RELOOP_VNPAY_HASH_SECRET=
RELOOP_VNPAY_RETURN_URL=
RELOOP_VNPAY_IPN_URL=
RELOOP_VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
RELOOP_VNPAY_EXPIRE_MINUTES=15

# Email SMTP tùy chọn. Outbox ghi pending/failed nếu chưa cấu hình hoặc gửi không thành công.
RELOOP_SMTP_HOST=
RELOOP_SMTP_PORT=587
RELOOP_SMTP_USER=
RELOOP_SMTP_PASSWORD=
RELOOP_EMAIL_FROM=
RELOOP_EMAIL_NAME=ReLoop Market

# Chỉ điền thông tin đơn vị đã được nhóm xác minh; không dùng placeholder giả như dữ liệu thật.
RELOOP_OPERATOR_NAME=
RELOOP_OPERATOR_TYPE=
RELOOP_OPERATOR_REPRESENTATIVE=
RELOOP_OPERATOR_TAX_CODE=
RELOOP_OPERATOR_ADDRESS=
RELOOP_CONTACT_EMAIL=
RELOOP_CONTACT_PHONE=
RELOOP_COMPLAINT_CHANNEL=
RELOOP_PRIVACY_CONTACT=
RELOOP_DATA_RETENTION_POLICY=
